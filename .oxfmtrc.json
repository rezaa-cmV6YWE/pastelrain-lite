{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "sortImports": true,
  "sortTailwindcss": {
    "stylesheet": "./src/styles.css",
    "functions": ["cn"]
  },
  "ignorePatterns": [
    ".agents/",
    ".omp/",
    "src/routeTree.gen.ts",
    "worker-configuration.d.ts",
    "pnpm-lock.yaml",
    "CHANGELOG.md"
  ]
}
