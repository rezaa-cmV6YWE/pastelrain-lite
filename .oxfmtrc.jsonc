{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "semi": false,
  "singleQuote": true,
  "trailingComma": "all",
  "printWidth": 80,
  "sortImports": {
    "groups": [
      "external",
      ["internal", "subpath"],
      ["parent", "sibling", "index"],
      "type",
      "unknown",
    ],
    "newlinesBetween": true,
  },
  "sortTailwindcss": {
    "functions": ["cn"],
  },
  "ignorePatterns": [
    "dist",
    "node_modules",
    "pnpm-lock.yaml",
    "src/routeTree.gen.ts",
    "worker-configuration.d.ts",
  ],
}
